# Set actual values in Vercel environment variables or an untracked .env.local.
# Random session encryption secret, at least 32 characters.
ARCHIVE_SESSION_SECRET=
# JSON array: [{"label":"Research team","digest":"SHA-256 of a normalized issued ID"}]
# Empty means no issued ID is allowed. Never commit actual IDs or session secrets.
ARCHIVE_ACCESS_IDS=[]
# Connected private Vercel Blob store. Server-side only; never prefix with VITE_.
BLOB_READ_WRITE_TOKEN=

# Neon Free server-side connection, automatically set by Vercel integration.
DATABASE_URL=
